generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  googleTokens  Json?     // Encrypted GSC OAuth tokens
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  sites         Site[]
  alerts        Alert[]
  apiKeys       ApiKey[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ API KEYS (BYOK) ============

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "dataforseo"
  encryptedLogin    String
  encryptedPassword String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ============ SITES ============

model Site {
  id          String   @id @default(cuid())
  userId      String
  domain      String   // e.g. "brandson.digital"
  gscProperty String?  // e.g. "sc-domain:brandson.digital"
  crawlBaselineId         String?
  crawlBaselineVerifiedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords      Keyword[]
  pages         Page[]
  crawls        Crawl[]
  vitals        VitalsReport[]
  alerts        Alert[]
  savedKeywords SavedKeyword[]
  rankSnapshots RankSnapshot[]
  pageReviews PageReview[]
  pageReviewRevisions PageReviewRevision[]

  @@unique([userId, domain])
}

// ============ MANUAL PAGE REVIEWS ============

model PageReview {
  id           String @id @default(cuid())
  siteId       String
  pageId       String
  canonicalUrl String

  pageFamily   PageFamily
  indexPolicy  IndexPolicy
  reviewStatus PageReviewStatus @default(UNREVIEWED)
  priority     ReviewPriority   @default(NONE)

  keywordOwnership           KeywordOwnershipStatus @default(UNDECIDED)
  primaryKeyword             String?
  primaryKeywordNormalized   String?
  keywordOwnerCanonical      String?
  keywordNotApplicableReason String?
  secondaryKeywords          Json?

  topicCluster     String?
  parentPage       String?
  clusterGaps      Json?
  maintenanceOwner String?
  editorialOwner   String?

  searchIntent SearchIntent @default(UNKNOWN)
  jobToBeDone  String?

  keywordPlannerEvidenceState   EvidenceState @default(MISSING)
  keywordPlannerEvidenceDetails Json?
  googleTrendsEvidenceState     EvidenceState @default(MISSING)
  googleTrendsEvidenceDetails   Json?
  measurementPlanEvidenceState  EvidenceState @default(MISSING)
  measurementPlanDetails        Json?

  serpSnapshotAt         DateTime?
  serpQuery              String?
  serpLocale             String?
  serpDevice             SerpDevice?
  serpMethod             SerpReviewMethod?
  serpCompetition        SerpCompetition @default(UNCLEAR)
  serpEvidenceState      EvidenceState @default(MISSING)
  serpEvidenceSummary    String?
  serpFeatures           Json?
  serpCompetitionSummary String?
  serpResults            Json?

  competitorOffer              String?
  currentOffer                 String?
  differentiation              String?
  differentiationEvidenceState EvidenceState @default(MISSING)

  eeatEvidence Json?
  eeatGaps     Json?
  eeatEvidenceDetails Json?
  eeatEvidenceState EvidenceState @default(MISSING)

  decisionState     PageDecisionState @default(PENDING)
  decisionRationale String?
  proposedChange    String?
  performanceState  PagePerformanceState @default(UNASSESSED)
  changeScope       PageChangeScope       @default(UNDECIDED)
  scopeRationale    String?
  demonstratedWins  Json?
  preservedElements Json?
  intentionallyChangedElements Json?
  changeBlastRadius PageChangeBlastRadius @default(UNDECIDED)
  affectedPageFamily PageFamily?
  affectedCanonicalCount Int?
  blastRadiusNote   String?
  experimentState  PageExperimentState @default(UNCHECKED)
  experimentId     String?
  experimentFrozenUntil DateTime?
  experimentExceptionReason String?
  rollbackTrigger  String?
  changeState       PageChangeState   @default(NOT_PLANNED)
  changeId          String?
  changedAt         DateTime?

  day7State       ReviewGateState @default(NOT_DUE)
  day7DueAt       DateTime?
  day7ReviewedAt  DateTime?
  day7Evidence    String?
  day7Decision    String?
  day7Rationale   String?
  day7NextAction  String?
  day28State      ReviewGateState @default(NOT_DUE)
  day28DueAt      DateTime?
  day28ReviewedAt DateTime?
  day28Evidence   String?
  day28Decision   String?
  day28Rationale  String?
  day28NextAction String?
  day56State      ReviewGateState @default(NOT_DUE)
  day56DueAt      DateTime?
  day56ReviewedAt DateTime?
  day56Evidence   String?
  day56Decision   String?
  day56Rationale  String?
  day56NextAction String?

  firstReviewedAt       DateTime?
  lastReviewedAt        DateTime?
  nextReviewAt          DateTime?
  manualNotes           String?
  manualChatState       ManualChatState @default(AWAITING_USER_SELECTION)
  userDecisionReference String?

  version   Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  revisions PageReviewRevision[]

  // Current-record uniqueness is enforced with partial indexes in the migration
  // so a soft-deleted review does not permanently reserve its URL or page ID.
  @@index([siteId, canonicalUrl])
  @@index([siteId, pageId])
  @@index([siteId, reviewStatus, priority])
  @@index([siteId, pageFamily])
  @@index([siteId, topicCluster])
  @@index([siteId, primaryKeywordNormalized])
}

model PageReviewRevision {
  id              String               @id @default(cuid())
  siteId          String
  reviewId        String
  version         Int
  changeType      PageReviewChangeType
  changedFields   Json
  snapshot        Json
  changeNote      String?
  changedByUserId String
  createdAt       DateTime             @default(now())

  site   Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  review PageReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, version])
  @@index([siteId, createdAt])
}

enum PageFamily {
  HOME
  REPORT_DIRECTORY
  STATE_REPORT_HUB
  RIVER_REPORT
  ARTICLE_DIRECTORY
  ARTICLE
  FLY_DIRECTORY
  FLY_FAMILY_GUIDE
  FLY_PATTERN_GUIDE
  WEEKLY_CONDITIONS_HUB
  WIDGET_LANDING_PAGE
  TRUST_COMPANY
  TRUST_METHODOLOGY
  LEGAL
  SUPPORT
  UTILITY
  OTHER
}

enum IndexPolicy {
  INDEX
  NOINDEX
  REDIRECT
  REMOVE
  UNDECIDED
}

enum PageReviewStatus {
  UNREVIEWED
  QUEUED
  RESEARCHING
  READY_NO_CHANGE
  READY_TO_CHANGE
  MONITORING
  COMPLETE
  BLOCKED
}

enum ReviewPriority {
  NONE
  P0
  P1
  P2
  P3
  P4
}

enum PagePerformanceState {
  UNASSESSED
  CRITICAL_DEFECT
  NO_OR_NEAR_ZERO_VISIBILITY
  IMPRESSIONS_WITHOUT_RESULT
  EARLY_OPPORTUNITY
  DEMONSTRATED_WINNER
  INSUFFICIENT_OBSERVATION
}

enum PageChangeScope {
  UNDECIDED
  FOCUSED
  COMPREHENSIVE
  NOT_APPLICABLE
}

enum PageChangeBlastRadius {
  UNDECIDED
  PAGE_LOCAL
  SHARED_TEMPLATE
  MIXED
  GLOBAL_NAVIGATION
  SOURCE_SENSITIVE
  NOT_APPLICABLE
}

enum PageExperimentState {
  UNCHECKED
  NONE
  FROZEN
  APPROVED_CONTAMINATION
}

enum KeywordOwnershipStatus {
  THIS_PAGE
  ANOTHER_CANONICAL
  UNDECIDED
  NOT_APPLICABLE
}

enum EvidenceState {
  VERIFIED
  PARTIAL
  MISSING
  NOT_APPLICABLE
}

enum ManualChatState {
  AWAITING_USER_SELECTION
  RESEARCHING
  AWAITING_USER_DECISION
  APPROVED_TO_RECORD
  APPROVED_TO_IMPLEMENT
  MONITORING
  COMPLETE
}

enum SearchIntent {
  UNKNOWN
  INFORMATIONAL
  LOCAL_TRIP_PLANNING
  COMMERCIAL_INVESTIGATION
  TRANSACTIONAL
  NAVIGATIONAL
  SAFETY_OR_RULES
  MIXED
  NOT_APPLICABLE
}

enum SerpDevice {
  DESKTOP
  MOBILE
}

enum SerpReviewMethod {
  MANUAL_GOOGLE
  MANUAL_OTHER
}

enum SerpCompetition {
  LOW
  MEDIUM
  HIGH
  UNCLEAR
}

enum PageDecisionState {
  PENDING
  NO_CHANGE
  CHANGE_RECOMMENDED
  INCONCLUSIVE
  KEEP
  EXPAND
  REVISE
  ITERATE
  MERGE
  REDIRECT
  NOINDEX
  RETIRE
  ROLLBACK
  BLOCKED
}

enum PageChangeState {
  NOT_PLANNED
  PLANNED
  IN_PROGRESS
  SHIPPED
  VERIFIED
  REVERTED
}

enum ReviewGateState {
  NOT_DUE
  DUE
  RECORDED
  MISSED
  NOT_APPLICABLE
}

enum PageReviewChangeType {
  CREATED
  UPDATED
  DELETED
  RESTORED
  SEEDED
}

// ============ GSC DATA ============

model Keyword {
  id          String   @id @default(cuid())
  siteId      String
  query       String   // The search query
  date        DateTime // Date of the data point
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  page        String // Landing page URL
  device      String // DESKTOP, MOBILE, TABLET
  country     String // ISO 3166-1 alpha-3 country code from GSC

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // A query can reach several pages on several device/country slices per day.
  @@unique([siteId, query, date, page, device, country])
  @@index([siteId, date])
  @@index([siteId, query, date])
  @@index([siteId, page, date])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ SAVED KEYWORDS ============

model SavedKeyword {
  id         String    @id @default(cuid())
  siteId     String
  query      String
  ownerPage  String
  intent     String?
  reviewedAt DateTime?
  status     String    @default("active")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query])
  @@index([siteId])
  @@index([siteId, ownerPage])
}

// ============ RANK TRACKING ============

model RankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  position    Float
  clicks      Int      @default(0)
  impressions Int      @default(0)
  page        String   @default("")
  date        DateTime

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, page, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
  @@index([siteId, page, date])
}

// ============ CRAWLER ============

model Crawl {
  id          String      @id @default(cuid())
  siteId      String
  status      CrawlStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  pagesFound  Int         @default(0)
  issuesFound Int         @default(0)
  healthScore Int?        // 0-100, informational until the rules are calibrated
  maxPages    Int         @default(1000)
  isBaseline          Boolean     @default(false)
  baselineVerifiedAt  DateTime?
  newIssuesFound      Int         @default(0)
  verifiedIssuesFound Int         @default(0)

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issues      CrawlIssue[]
  auditPages  AuditPage[]
  auditLinks  AuditLink[]

  @@index([siteId, startedAt])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============ AUDIT PAGE DATA ============

model AuditPage {
  id              String  @id @default(cuid())
  crawlId         String
  url             String
  statusCode      Int
  redirectUrl     String?

  title           String?
  description     String?
  canonical       String?
  robotsMeta      String?

  h1Count         Int     @default(0)
  h1s             Json?   // Array of H1 text
  wordCount       Int     @default(0)

  imageCount      Int     @default(0)
  imagesMissingAlt Int    @default(0)

  internalLinks   Int     @default(0)
  externalLinks   Int     @default(0)

  hasSchema       Boolean @default(false)
  hreflangTags    Json?   // Array of hreflang values

  contentScore    Int     @default(0)  // 0-100
  contentHash     String? // SHA-256 of body text

  responseTimeMs  Int     @default(0)
  byteSize        Int     @default(0)
  indexable       Boolean @default(true)

  crawl           Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, url])
}

// ============ AUDIT LINK GRAPH ============

model AuditLink {
  id          String  @id @default(cuid())
  crawlId     String
  sourceUrl   String
  targetUrl   String
  anchorText  String?
  isInternal  Boolean @default(true)
  isNofollow  Boolean @default(false)
  statusCode  Int?

  crawl       Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, sourceUrl])
}

model CrawlIssue {
  id          String        @id @default(cuid())
  crawlId     String
  url         String
  type        IssueType
  severity    IssueSeverity
  message     String
  details     Json?         // Additional context
  fingerprint      String?
  isNew            Boolean       @default(false)
  isActionable     Boolean       @default(false)
  isVerified       Boolean       @default(false)
  suppressedReason String?

  crawl       Crawl         @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId, type])
  @@index([crawlId, isNew, isVerified])
  @@index([fingerprint])
}

enum IssueType {
  BROKEN_LINK           // 404, 500, etc.
  REDIRECT              // 301, 302 chains
  MISSING_TITLE         // No <title> tag
  MISSING_DESCRIPTION   // No meta description
  DUPLICATE_TITLE       // Same title on multiple pages
  DUPLICATE_DESCRIPTION // Same description on multiple pages
  MISSING_H1            // No H1 heading
  MULTIPLE_H1           // More than one H1
  MISSING_ALT           // Images without alt text
  MISSING_CANONICAL     // No canonical tag
  MISSING_ROBOTS        // No robots.txt
  MISSING_SITEMAP       // No sitemap.xml
  MISSING_SCHEMA        // No structured data
  SLOW_PAGE             // Load time > 3s
  MIXED_CONTENT         // HTTP resources on HTTPS page
  LARGE_PAGE            // Page size > 3MB
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

// ============ CORE WEB VITALS ============

model VitalsReport {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime @default(now())
  device      String   // MOBILE or DESKTOP

  // Core Web Vitals
  lcp         Float?   // Largest Contentful Paint (seconds)
  fid         Float?   // First Input Delay (milliseconds)
  cls         Float?   // Cumulative Layout Shift (score)
  inp         Float?   // Interaction to Next Paint (milliseconds)

  // Performance
  perfScore   Int?     // 0-100 Lighthouse performance score
  speedIndex  Float?   // Speed Index (seconds)
  ttfb        Float?   // Time to First Byte (seconds)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ ALERTS ============

model Alert {
  id          String     @id @default(cuid())
  userId      String
  siteId      String
  type        AlertType
  channel     AlertChannel
  config      Json       // Thresholds, webhook URL, etc.
  enabled     Boolean    @default(true)
  lastFired   DateTime?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum AlertType {
  TRAFFIC_DROP       // Clicks dropped > X%
  POSITION_CHANGE    // Keyword position changed > X
  NEW_404            // New broken links detected
  VITALS_DEGRADED    // Core Web Vitals got worse
  CRAWL_ISSUES       // New crawl issues detected
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK
}
